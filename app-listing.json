{
  "//": "Sentin8:App store listing manifest for eExchange. This file is the literal request body for POST /v1/app/store/listings (snake_case keys). Re-seed via `make seed` (db seed-listings). Keep in sync with the eExchange app's BFF client scopes.",

  "app_name": "Exchange8:eExchange",
  "app_slug": "exchange8-eexchange",
  "description": "Equities, derivatives and commodities trading: order entry, blotter, market data depth/BBO/tape, auction participation, and operations surfaces.",
  "backend_url": "http://localhost:8026",
  "supports_dcr": true,
  "visibility": "public",
  "status": "published",

  "oauth_defaults": {
    "grant_types": ["authorization_code", "refresh_token"],
    "response_types": ["code"],
    "token_endpoint_auth_method": "none",
    "scopes": [
      "openid", "profile", "email",
      "exchange8:gateway:orders:read", "exchange8:gateway:orders:write",
      "exchange8:gateway:connections:read",
      "exchange8:md:marketdata:read", "exchange8:md:snapshot:read",
      "exchange8:risk:authorize:read",
      "exchange8:clearing:trades:read",
      "exchange8:margin:positions:read", "exchange8:margin:margin:read"
    ],
    "redirect_uris": ["http://localhost:8099/callback"],
    "post_logout_redirect_uris": ["http://localhost:8099/"]
  },

  "developer": {
    "name": "Exchange8 Product Engineering",
    "support_email": "exchange8-ops@local.sentin8.dev"
  },

  "branding": {
    "accent_color": "#D4AF37",
    "tagline": "Trade the full book."
  }
}